<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <!-- PackageId differs from the assembly name on purpose; see Loom.Telemetry.csproj and
         BACKLOG.md 11.7. ToolCommandName is what users actually type and is unchanged. -->
    <PackageId>LoomDiagnostics.Dashboard</PackageId>
    <ToolCommandName>loom-dashboard</ToolCommandName>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <!-- Package metadata. PackageId, ToolCommandName and PackAsTool stay in the group
       above; this group is the nuget.org-facing description only. -->
  <PropertyGroup>
    <!-- Without this, MSBuild falls back to the assembly name and nuget.org shows
         "Loom.Dashboard" as the author. -->
    <Authors>Angelo Davales</Authors>
    <Description>Local telemetry dashboard for .NET processes. A dotnet tool that attaches to a running process by PID and serves live metrics, logs, queries and alerts over a loopback-only HTTP endpoint. Binds 127.0.0.1 in code; remote access is an SSH tunnel.</Description>
    <PackageTags>telemetry;metrics;logging;diagnostics;dashboard;dotnet-tool;profiling</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/m4ngk4n08/Project-Loom-v2</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Loom.Dashboard.AspNetCore\Loom.Dashboard.AspNetCore.csproj" />
    <ProjectReference Include="..\Loom.Security\Loom.Security.csproj" />
    <ProjectReference Include="..\Loom.Storage\Loom.Storage.csproj" />
    <ProjectReference Include="..\Loom.Web.Contracts\Loom.Web.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\Loom.Web.Frontend\dist\Loom.Web.Frontend\browser\**\*" LinkBase="wwwroot" />
  </ItemGroup>
</Project>
