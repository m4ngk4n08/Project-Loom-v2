<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <!-- PackageId differs from the assembly name on purpose; see Loom.Telemetry.csproj and
         BACKLOG.md 11.7. ToolCommandName is what users actually type and is unchanged. -->
    <PackageId>LoomDiagnostics.Cli</PackageId>
    <ToolCommandName>loom</ToolCommandName>
    <PackAsTool>true</PackAsTool>
  </PropertyGroup>

  <!-- Package metadata. PackageId, ToolCommandName and PackAsTool stay in the group
       above; this group is the nuget.org-facing description only. -->
  <PropertyGroup>
    <Description>Command-line companion to Loom. Attaches to a running .NET process over EventPipe to stream logs and metrics, runs Loom queries against a live process, and mints scope-restricted tokens for the Loom dashboard.</Description>
    <PackageTags>telemetry;metrics;logging;diagnostics;cli;dotnet-tool;eventpipe</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/m4ngk4n08/Project-Loom-v2</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.607501" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.18" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <ProjectReference Include="..\Loom.Security\Loom.Security.csproj" />
    <ProjectReference Include="..\Loom.Storage\Loom.Storage.csproj" />
    <ProjectReference Include="..\Loom.Telemetry\Loom.Telemetry.csproj" />
    <ProjectReference Include="..\Loom.Telemetry.Query\Loom.Telemetry.Query.csproj" />
    <ProjectReference Include="..\Loom.Web.Contracts\Loom.Web.Contracts.csproj" />
  </ItemGroup>
</Project>
