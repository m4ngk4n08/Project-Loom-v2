<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <!-- PackageId differs from the assembly name on purpose; see Loom.Telemetry.csproj and
         BACKLOG.md 11.7. ToolCommandName is what users actually type and is unchanged. -->
    <PackageId>LoomDiagnostics.Dashboard</PackageId>
    <ToolCommandName>loom-dashboard</ToolCommandName>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <!-- Emits compile-time interceptors for the Map* calls in EndpointExtensions, replacing
         the reflective delegate binding that trips IL2026 under EnableTrimAnalyzer. Without
         it a CI job that turns the trim analyzer on solution-wide fails with 24 errors here,
         because this project otherwise sets no analyzer properties at all. Suppression is
         not an alternative: interceptors apply only within the compilation holding the call
         site, so suppressing would leave the reflective path live at runtime. -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.607501" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.18" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Loom.Security\Loom.Security.csproj" />
    <ProjectReference Include="..\Loom.Storage\Loom.Storage.csproj" />
    <ProjectReference Include="..\Loom.Telemetry\Loom.Telemetry.csproj" />
    <ProjectReference Include="..\Loom.Telemetry.Query\Loom.Telemetry.Query.csproj" />
    <ProjectReference Include="..\Loom.Telemetry.Alerting\Loom.Telemetry.Alerting.csproj" />
    <ProjectReference Include="..\Loom.Telemetry.Assist\Loom.Telemetry.Assist.csproj" />
    <ProjectReference Include="..\Loom.Telemetry.Exporters\Loom.Telemetry.Exporters.csproj" />
    <ProjectReference Include="..\Loom.Web.Contracts\Loom.Web.Contracts.csproj" />
    <ProjectReference Include="..\Loom.Web.RealTime\Loom.Web.RealTime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\Loom.Web.Frontend\dist\Loom.Web.Frontend\browser\**\*" LinkBase="wwwroot" />
  </ItemGroup>
</Project>
