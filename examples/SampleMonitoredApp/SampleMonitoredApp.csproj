<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Demo app, never shipped. -->
    <IsPackable>false</IsPackable>

    <!-- References the generator directly (ProjectReference), not through the packed
         nupkg, so LoomDiagnostics.Telemetry.props' auto-import never fires here. Set by
         hand so [LoomProfile] on OrderService/PaymentService actually intercepts. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Loom.Telemetry.GeneratedInterceptors</InterceptorsNamespaces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Loom.Telemetry\Loom.Telemetry.csproj" />
    <ProjectReference Include="..\..\Loom.Telemetry.Generators\Loom.Telemetry.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
