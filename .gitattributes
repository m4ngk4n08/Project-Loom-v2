# Default: normalize line endings to LF in the repo, checkout using OS default
* text=auto

# Unix shell scripts must use LF
*.sh text eol=lf

# Windows-only scripts must use CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binaries
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.snk binary
*.pfx binary

# Interceptor call sites. The checked-in Loom.Telemetry.Tests/Generated/.../LoomProfileInterceptors.g.cs
# carries a content checksum of each of these files, and that checksum changes with line endings. Pinned
# to LF so a Windows (CRLF) checkout hashes the same bytes as Linux and the file is not rewritten by a build.
Loom.Telemetry.Tests/GeneratorTests.cs text eol=lf
Loom.Telemetry.Tests/LoomProfileInterceptorTests.cs text eol=lf
Loom.Telemetry.Tests/LoomProfileInterfaceDispatchTests.cs text eol=lf
Loom.Telemetry.Tests/RecordingAllocationTests.cs text eol=lf
