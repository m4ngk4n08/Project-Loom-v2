<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <!-- Emits compile-time interceptors for the Map* calls in EndpointExtensions, replacing
         the reflective delegate binding that trips IL2026 under EnableTrimAnalyzer. Without
         it a CI job that turns the trim analyzer on solution-wide fails with 24 errors here,
         because this project otherwise sets no analyzer properties at all. Suppression is
         not an alternative: interceptors apply only within the compilation holding the call
         site, so suppressing would leave the reflective path live at runtime. -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>

  <!-- Package identity. Ships the mountable dashboard API with no UI. The seven supporting
       libraries below are bundled into lib/net10.0/ rather than published on their own
       (BACKLOG.md 11.1 item 3, decision 2026-09-21); Loom.Telemetry stays a real package
       dependency. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>LoomDiagnostics.Dashboard.AspNetCore</PackageId>
    <Authors>Angelo Davales</Authors>
    <Description>The mountable Loom dashboard API for an ASP.NET Core app: AddLoomDashboard / UseLoomDashboard / MapLoomDashboard expose live metrics, logs, queries and alerts over authenticated endpoints. Ships no UI.</Description>
    <PackageTags>telemetry;metrics;logging;diagnostics;dashboard;aspnetcore</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/m4ngk4n08/Project-Loom-v2</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);LoomBundleSupportingLibraries</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.607501" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.18" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Loom.Security\Loom.Security.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Loom.Storage\Loom.Storage.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Loom.Telemetry\Loom.Telemetry.csproj" />
    <ProjectReference Include="..\Loom.Telemetry.Query\Loom.Telemetry.Query.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Loom.Telemetry.Alerting\Loom.Telemetry.Alerting.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Loom.Telemetry.Exporters\Loom.Telemetry.Exporters.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Loom.Web.Contracts\Loom.Web.Contracts.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Loom.Web.RealTime\Loom.Web.RealTime.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- Adds the seven supporting assemblies to lib/net10.0/. Selected by NAME: a blanket
       "every ProjectReference output" filter would also ship Loom.Telemetry.dll, a second
       copy of the library that is published on its own. Each output path is asked of its
       own project (GetTargetPath) because TargetsForTfmSpecificBuildOutput runs through
       CallTarget, where @(ReferencePath) is empty - measured, not assumed. -->
  <Target Name="LoomBundleSupportingLibraries">
    <ItemGroup>
      <LoomBundledProject Include="@(ProjectReference)"
                          Condition="'%(Filename)' == 'Loom.Security'
                                  Or '%(Filename)' == 'Loom.Storage'
                                  Or '%(Filename)' == 'Loom.Telemetry.Query'
                                  Or '%(Filename)' == 'Loom.Telemetry.Alerting'
                                  Or '%(Filename)' == 'Loom.Telemetry.Exporters'
                                  Or '%(Filename)' == 'Loom.Web.Contracts'
                                  Or '%(Filename)' == 'Loom.Web.RealTime'" />
    </ItemGroup>
    <MSBuild Projects="@(LoomBundledProject)"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)"
             SkipNonexistentTargets="false">
      <Output TaskParameter="TargetOutputs" ItemName="LoomBundledAssembly" />
    </MSBuild>
    <ItemGroup>
      <BuildOutputInPackage Include="@(LoomBundledAssembly)" />
    </ItemGroup>
  </Target>
</Project>