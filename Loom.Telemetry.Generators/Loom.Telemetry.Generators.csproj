<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<IsRoslynComponent>true</IsRoslynComponent>
		<!-- SemanticModel.GetInterceptableLocation / InterceptableLocation.GetInterceptsLocationAttributeSyntax
		     are the ONLY interceptor mechanism this pinned Roslyn version (4.11.0) accepts
		     without emitting the obsolete-shape warning CS9270 in consumers - confirmed by
		     compiling both shapes against the real compiler. The API is marked
		     [Experimental("RSEXPERIMENTAL002")] in this version; suppressed here (in the
		     generator's own compilation) only, not in consumer projects. -->
		<NoWarn>$(NoWarn);RSEXPERIMENTAL002</NoWarn>

		<!-- Never a package of its own: BACKLOG.md 11.6 ships this generator INSIDE
		     LoomDiagnostics.Telemetry at analyzers/dotnet/cs/, via the LoomPackGenerator
		     target in Loom.Telemetry.csproj. A standalone package would be a second,
		     divergent copy. -->
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
	</ItemGroup>
</Project>