<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>

    <!-- Not published. Public IDs for the supporting libraries are decided with
         BACKLOG.md 11.1 item 3; until then a solution-wide pack must not emit them
         under the unreserved Loom. prefix (11.7). -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Loom.Storage\Loom.Storage.csproj" />
    <ProjectReference Include="..\Loom.Telemetry\Loom.Telemetry.csproj" />
    <ProjectReference Include="..\Loom.Telemetry.Query\Loom.Telemetry.Query.csproj" />
    <ProjectReference Include="..\Loom.Web.Contracts\Loom.Web.Contracts.csproj" />
  </ItemGroup>
</Project>
