<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- <clear /> is required, not tidiness: without it NuGet merges every parent and
         machine-level config, and a developer's own feed could satisfy
         LoomDiagnostics.Dashboard.AspNetCore instead of the package this commit just packed. -->
    <clear />
    <!-- Relative to this file's directory. artifacts/ is gitignored, so the feed never
         gets staged. Separate from the Telemetry gate's loom-feed so a failure in either
         names which package broke. -->
    <add key="loom-dashboard-local" value="../../artifacts/loom-dashboard-feed" />
    <!-- Needed for the third-party dependencies (Microsoft.Diagnostics.*). -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
