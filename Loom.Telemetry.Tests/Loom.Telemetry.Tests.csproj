<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>disable</ImplicitUsings>
		<IsAotCompatible>true</IsAotCompatible>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.0" />
		<PackageReference Include="xunit" Version="2.9.0" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>
				runtime; build; native; contentfiles; analyzers; buildtransitive
			</IncludeAssets>
	</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<!-- Exclude generated files from compilation - they're already included by the generator -->
		<Compile Remove="Generated/**/*.cs" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Loom.Security\Loom.Security.csproj" />
		<ProjectReference Include="..\Loom.Storage\Loom.Storage.csproj" />
		<ProjectReference Include="..\Loom.Telemetry.Generators\Loom.Telemetry.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	  <ProjectReference Include="..\Loom.Telemetry.Query\Loom.Telemetry.Query.csproj" />
	  <ProjectReference Include="..\Loom.Telemetry\Loom.Telemetry.csproj" />
	  <ProjectReference Include="..\Loom.Telemetry.Alerting\Loom.Telemetry.Alerting.csproj" />
	  <ProjectReference Include="..\Loom.Telemetry.Assist\Loom.Telemetry.Assist.csproj" />
	  <ProjectReference Include="..\Loom.Telemetry.Exporters\Loom.Telemetry.Exporters.csproj" />
	  <ProjectReference Include="..\Loom.Web.Contracts\Loom.Web.Contracts.csproj" />
	  <ProjectReference Include="..\Loom.Web.Api\Loom.Web.Api.csproj" />
	  <ProjectReference Include="..\Loom.Dashboard\Loom.Dashboard.csproj" />
	  <ProjectReference Include="..\Loom.DevTools\Loom.DevTools.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Moq" Version="4.20.72" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
	</ItemGroup>
</Project>