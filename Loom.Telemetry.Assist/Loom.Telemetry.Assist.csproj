<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>

    <!-- Not published. Public IDs for the supporting libraries are decided with
         BACKLOG.md 11.1 item 3; until then a solution-wide pack must not emit them
         under the unreserved Loom. prefix (11.7). -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- IExplainClient, ExplainResult, ExplainPayload, ExplainPayloadBuilder live here -
         the provider-neutral half of the Explain feature, moved out of this project so
         Loom.Dashboard.AspNetCore can depend on the abstraction without dragging in this
         project's Anthropic-specific implementation. See PROMPT-assist-inversion.md and
         BACKLOG.md 11.2. -->
    <ProjectReference Include="..\Loom.Web.Contracts\Loom.Web.Contracts.csproj" />
  </ItemGroup>
</Project>
