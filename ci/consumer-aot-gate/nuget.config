<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- <clear /> is required, not tidiness: without it NuGet merges every parent and
         machine-level config, and a developer's own feed could satisfy
         LoomDiagnostics.Telemetry instead of the package this commit just packed. -->
    <clear />
    <!-- Relative to this file's directory. artifacts/ is gitignored, so the feed never
         gets staged. -->
    <add key="loom-local" value="../../artifacts/loom-feed" />
    <!-- Needed only for Microsoft.Extensions.DependencyInjection. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
