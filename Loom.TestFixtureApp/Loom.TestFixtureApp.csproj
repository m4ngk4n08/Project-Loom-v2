<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Integration-test fixture, never shipped. dotnet pack Loom.slnx must keep emitting
         exactly the 4 packages it emits today; a fifth here would be a regression. -->
    <IsPackable>false</IsPackable>

    <!-- References the generator directly (ProjectReference), not through the packed
         nupkg, so LoomDiagnostics.Telemetry.props' auto-import never fires here. Set by
         hand so [LoomProfile] interceptors (if any are ever added here) actually intercept. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Loom.Telemetry.GeneratedInterceptors</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.EventSource" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Loom.Telemetry\Loom.Telemetry.csproj" />
    <ProjectReference Include="..\Loom.Telemetry.Generators\Loom.Telemetry.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
