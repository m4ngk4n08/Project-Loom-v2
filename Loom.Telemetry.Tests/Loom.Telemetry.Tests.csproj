<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>disable</ImplicitUsings>
		<IsAotCompatible>true</IsAotCompatible>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
		<!-- xUnit1031 fires at InMemoryMetricStoreTests.cs:372 and :387, where blocking on the
		     task IS the behaviour under test. Both are long-documented as expected in CLAUDE.md.
		     Without this, the CI build in IMPLEMENTATION-METHODOLOGY.md Step 15.3 - which passes
		     TreatWarningsAsErrors=true solution-wide - fails on two warnings it is not there to
		     catch. Scoped to this one rule rather than TreatWarningsAsErrors=false so a genuinely
		     new warning in the test project still fails the build. -->
		<WarningsNotAsErrors>xUnit1031</WarningsNotAsErrors>
		<!-- This project references the generator directly via ProjectReference, not
		     through the packed LoomDiagnostics.Telemetry nupkg, so it never sees
		     Loom.Telemetry/build/LoomDiagnostics.Telemetry.props' auto-import - that only
		     fires for a real NuGet consumer. Set the same property by hand so
		     [LoomProfile] interceptors activate here too. Must match
		     LoomProfileGenerator.InterceptorsNamespace exactly. -->
		<InterceptorsNamespaces>$(InterceptorsNamespaces);Loom.Telemetry.GeneratedInterceptors</InterceptorsNamespaces>
	</PropertyGroup>

	<ItemGroup>
		<!-- Pinned to the exact version Loom.Telemetry.Generators.csproj pins, so
		     GeneratorTests exercises LoomProfileGenerator against the same compiler
		     surface it will actually run under. -->
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.0" />
		<PackageReference Include="xunit" Version="2.9.0" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>
				runtime; build; native; contentfiles; analyzers; buildtransitive
			</IncludeAssets>
	</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<!-- Exclude generated files from compilation - they're already included by the generator -->
		<Compile Remove="Generated/**/*.cs" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Loom.Security\Loom.Security.csproj" />
		<ProjectReference Include="..\Loom.Storage\Loom.Storage.csproj" />
		<ProjectReference Include="..\Loom.Telemetry.Generators\Loom.Telemetry.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
	  <ProjectReference Include="..\Loom.Telemetry.Query\Loom.Telemetry.Query.csproj" />
	  <ProjectReference Include="..\Loom.Telemetry\Loom.Telemetry.csproj" />
	  <ProjectReference Include="..\Loom.Telemetry.Alerting\Loom.Telemetry.Alerting.csproj" />
	  <ProjectReference Include="..\Loom.Telemetry.Assist\Loom.Telemetry.Assist.csproj" />
	  <ProjectReference Include="..\Loom.Telemetry.Exporters\Loom.Telemetry.Exporters.csproj" />
	  <ProjectReference Include="..\Loom.Web.Contracts\Loom.Web.Contracts.csproj" />
	  <ProjectReference Include="..\Loom.Dashboard\Loom.Dashboard.csproj" />
	  <ProjectReference Include="..\Loom.Dashboard.AspNetCore\Loom.Dashboard.AspNetCore.csproj" />
	  <ProjectReference Include="..\Loom.DevTools\Loom.DevTools.csproj" />
	  <ProjectReference Include="..\Loom.TestFixtureApp\Loom.TestFixtureApp.csproj" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>LoomFixtureAppPath</_Parameter1>
			<_Parameter2>$(MSBuildThisFileDirectory)..\Loom.TestFixtureApp\bin\$(Configuration)\net10.0\Loom.TestFixtureApp.dll</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Moq" Version="4.20.72" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
	</ItemGroup>
</Project>