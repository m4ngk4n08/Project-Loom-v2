<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Native AOT Configuration -->
		<PublishAot>true</PublishAot>
		<IsTrimmable>true</IsTrimmable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<EnableAotAnalyzer>true</EnableAotAnalyzer>
		<EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- Binary Size Optimization -->
		<InvariantGlobalization>true</InvariantGlobalization>
		<PublishTrimmed>true</PublishTrimmed>
		<TrimMode>link</TrimMode>
		<UserSecretsId>7387c81c-b1c6-4bec-a0fa-8e9cadfd550f</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<!-- Reference our Contracts project -->
		<ProjectReference Include="..\Loom.Storage\Loom.Storage.csproj" />
		<ProjectReference Include="..\Loom.Telemetry.Exporters\Loom.Telemetry.Exporters.csproj" />
		<ProjectReference Include="..\Loom.Telemetry.Query\Loom.Telemetry.Query.csproj" />
		<ProjectReference Include="..\Loom.Telemetry.Alerting\Loom.Telemetry.Alerting.csproj" />
		<ProjectReference Include="..\Loom.Web.Contracts\Loom.Web.Contracts.csproj" />
		<ProjectReference Include="..\Loom.Web.RealTime\Loom.Web.RealTime.csproj" />
	</ItemGroup>
</Project>